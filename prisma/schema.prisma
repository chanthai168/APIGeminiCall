generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transcribe {
  id                 String   @id @default(uuid())
  audio_name         String
  transcription      String
  url                String
  transcription_json Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
